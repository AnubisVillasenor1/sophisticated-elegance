# Copia este archivo a `.env` y rellena los valores reales.
# Nunca subas `.env` al repositorio: está ignorado por git.

# --- Supabase (público, seguro para el navegador) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE
VITE_SUPABASE_PROJECT_ID=TU_PROJECT_ID

# --- Servidor (solo runtime, sin prefijo VITE_) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE
SUPABASE_PROJECT_ID=TU_PROJECT_ID

# Clave de servicio: solo si necesitas operaciones administrativas
# (eliminación de cuentas, panel de administración). Nunca en el cliente.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Autorización (allowlists de servidor, separadas por comas) ---
# Sin allowlist no hay administradores: el sistema falla cerrado.
ADMIN_EMAILS=
CREATOR_EMAILS=
# Vinculo cuenta -> slug editorial: creadora@correo.com=valentina-r
CREATOR_SLUGS=

# --- Modo de autenticación ---
# Omitir o `false` en producción. `true` solo para builds de demostración.
VITE_DEMO_MODE=false

# --- Sitio ---
VITE_SITE_URL=https://sophisticated-elegance.vercel.app

# --- Cobros (fallo cerrado si falta cualquiera) ---
# Sin PAYMENT_PROVIDER válido toda compra se rechaza con un mensaje explícito:
# no se crea un pedido ni se simula un cobro.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Endpoint del webhook: https://TU-DOMINIO/api/payments/webhook

# --- Base de datos (solo scripts de mantenimiento) ---
# Necesaria para `node scripts/apply-db.mjs` y `node scripts/preflight.mjs`.
# POSTGRES_URL=postgres://...

